<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0.69</Version>
    <AssemblyVersion>1.0.0.69</AssemblyVersion>
    <FileVersion>1.0.0.69</FileVersion>
    <InformationalVersion>1.0.0.69</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="Jellyfin.Model" Version="12.4.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.js" />
    <EmbeddedResource Include="Web\requests.html" />
    <EmbeddedResource Include="Web\requests.css" />
    <EmbeddedResource Include="Web\requests.js" />
    <EmbeddedResource Include="Navigation\Requests-navigation.js" />
  </ItemGroup>

</Project>